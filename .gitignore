# Ignore system files
.DS_Store
Thumbs.db
*.log
*.tmp

# Ignore editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore node modules (if using npm)
node_modules/

# Ignore build files
dist/
build/
new-files/

# Allow all project files
!*.html
!*.css
!*.js
!*.json
!*.md
!*.txt
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.ico
!*.xml


# Ignore CodeIgniter 4 writable contents
cache/*
!cache/index.html

debugbar/*
!debugbar/index.html

logs/*
!logs/index.html

session/*
!session/index.html

uploads/*
!uploads/index.html

# Keep main security files tracked
!.htaccess
!index.html 