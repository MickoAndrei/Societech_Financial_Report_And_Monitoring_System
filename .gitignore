# Ignore system files
.DS_Store
Thumbs.db
*.log
*.tmp

# Ignore editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore node modules (if using npm)
node_modules/

# Ignore build files
dist/
build/
new-files/

# Allow all project files
!*.html
!*.css
!*.js
!*.json
!*.md
!*.txt
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.ico
!*.xml


# Ignore CodeIgniter 4 writable contents
/writable/cache/*
!/writable/cache/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

# Ignore framework json/html files in writable root
/writable/*.json
/writable/*.html