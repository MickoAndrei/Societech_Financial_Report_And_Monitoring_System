DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|map|txt|json)$ [NC]
    RewriteRule ^(login|register|auth|student|treasurer|admin|super-admin|reports|api)(/.*)?$ public/index.php/$1$2 [L,QSA]

    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
